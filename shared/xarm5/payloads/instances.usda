#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "link_base" (
        prepend references = @./geometries.usd@</Geometries/link_base>
    )
    {
        over "link_base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/link_base/VisualMaterials/White>
        }

        def Scope "VisualMaterials"
        {
            def Material "White" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/White>
            )
            {
            }
        }
    }

    def Xform "link_base_1" (
        prepend references = @./geometries.usd@</Geometries/link_base>
    )
    {
        over "link_base" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

