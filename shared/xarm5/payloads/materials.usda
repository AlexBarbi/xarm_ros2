#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "White"
    {
        color3f inputs:diffuseColor = (0.99999994, 1, 0.9999999)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/White/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/White.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/White.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/White.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/White.inputs:roughness>
            token outputs:surface
        }
    }

    def Material "Silver"
    {
        color3f inputs:diffuseColor = (0.52720726, 0.5272073, 0.52720726)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/Silver/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/Silver.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/Silver.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/Silver.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/Silver.inputs:roughness>
            token outputs:surface
        }
    }
}

